  { word: "emergency", translation: "favqulodda" },
  { word: "fever", translation: "isitma" },
  { word: "heart", translation: "yurak" },
  { word: "medicine", translation: "tibbiyot, dori" },
  { word: "oxygen", translation: "kislorod" },
  { word: "patient", translation: "bemor" },
  { word: "surgery", translation: "jarrohlik" },
  { word: "treatment", translation: "davo" },
  { word: "wound", translation: "jarohat" },
  { word: "symptoms", translation: "belgilar, alomatlar" },
  { word: "pharmacy", translation: "dorixona" },
  { word: "hospital", translation: "shifoxona" },
  { word: "appointment", translation: "uchrashuv, qabul" },
  { word: "tooth", translation: "tish" },
