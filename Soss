  { word: "famous", translation: "mashhur" },
  { word: "beautiful", translation: "chiroyli" },
  { word: "bad", translation: "yomon" },
  { word: "far", translation: "uzoq" },
];

// ✅ Function to get 4 random words
const getRandomWords = () => {
  let shuffled = [...words].sort(() => Math.random() - 0.5);
  return shuffled.slice(0, 4);
};

const Quiz = () => {
  const [options, setOptions] = useState(getRandomWords());
  const [correctAnswer, setCorrectAnswer] = useState(options[0]); // ✅ Correct answer is always first
  const [score, setScore] = useState(0);

  // ✅ Handle answer selection
  const handleAnswer = (answer) => {
    if (answer.word === correctAnswer.word) {
      setScore(score + 1);
    }

    const newOptions = getRandomWords();
    setOptions(newOptions);
    setCorrectAnswer(newOptions[0]);
  };

  return (
    <div style={{ textAlign: "center", fontFamily: "Arial, sans-serif" }}>
      <h2>
        What is the meaning of <span style={{ color: "blue" }}>"{correctAnswer.word}"</span>?
      </h2>
      {options.map((option) => (
        <button
          key={option.word}
          onClick={() => handleAnswer(option)}
          style={{
            display: "block",
            margin: "10px auto",
            padding: "10px 20px",
            fontSize: "18px",
            cursor: "pointer",
            backgroundColor: "#f0f0f0",
            border: "1px solid #ccc",
            borderRadius: "5px",
          }}
        >
          {option.translation}
        </button>
      ))}
      <p><strong>Score:</strong> {score}</p>
    </div>
  );
};

export default Quiz;
