// ✅ Cleaned words list (No duplicates, no errors)
const words = [
  { word: "aid", translation: "yordam" },
  { word: "blood", translation: "qon" },
  { word: "cinema", translation: "kino" },
  { word: "clinic", translation: "klinika" },
