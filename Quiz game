const getRandomWords = () => {
  const shuffled = [...words].sort(() => 0.5 - Math.random()); // Use [...words] to avoid mutating original array
  return shuffled.slice(0, 4);
};

const Quiz = () => {
  const [question, setQuestion] = useState(getRandomWords());
  const [correct, setCorrect] = useState(question[0]); // Pick the first word as correct
  const [score, setScore] = useState(0);

  const handleAnswer = (answer) => {
    if (answer.word === correct.word) {
      setScore(score + 1);
    }
    const newQuestion = getRandomWords();
    setQuestion(newQuestion);
    setCorrect(newQuestion[0]);
  };

  return (
    <div>
      <h2>What is the meaning of "{correct.word}"?</h2>
      {question.map((q) => (
        <button key={q.word} onClick={() => handleAnswer(q)}>
          {q.translation}
        </button>
      ))}
      <p>Score: {score}</p>
    </div>
  );
};

export default Quiz;
